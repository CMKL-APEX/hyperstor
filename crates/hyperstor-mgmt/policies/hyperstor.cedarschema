// The management service's schema (spec/19-administration.md §23.9.2):
// people, the cluster, and one action per call a person may make,
// each in the group of the role that allows it. Written by hand; a test
// checks it against the protos and mgmt's table of actions.
namespace Hyperstor {
  entity User = { "roles": Set<String> };
  entity Cluster;
  type Auth = { "method": String, "transport": String, "age_secs": Long, "mfa": Bool };

  action "read";
  action "operate";
  action "store";
  action "secure";
  action "own";
  action "step-up";

  action "ClusterService.GetStatus" in [Action::"read"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.ListPgs" in [Action::"read"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.GetPgGrid" in [Action::"read"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.GetScrubStatus" in [Action::"read"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.ListPgScrubs" in [Action::"read"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.GetPgHeat" in [Action::"read"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.ListDevicePerf" in [Action::"read"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.ListPorts" in [Action::"read"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.ListClaims" in [Action::"read"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.ListTopVolumes" in [Action::"read"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.ListFindings" in [Action::"read"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.ListVolumes" in [Action::"read"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "OperationService.GetOperation" in [Action::"read"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "OperationService.ListOperations" in [Action::"read"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "OperationService.WatchOperation" in [Action::"read"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "MemberService.ListMembers" in [Action::"read"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "S3Service.ListS3Placements" in [Action::"read"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "S3Service.ListS3Buckets" in [Action::"read"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "S3Service.GetS3Bucket" in [Action::"read"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "RealmService.ListRealms" in [Action::"read"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "Dashboard.Read" in [Action::"read"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.SetDeviceIn" in [Action::"operate"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.SetDeviceWeight" in [Action::"operate"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.SetFullRatios" in [Action::"operate"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.AddDevice" in [Action::"operate"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.RemoveDevice" in [Action::"operate", Action::"step-up"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.SetDeviceClass" in [Action::"operate"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.SetEndpoints" in [Action::"operate"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.SetPortRole" in [Action::"operate"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.SetLending" in [Action::"operate"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.ReleaseClaim" in [Action::"operate"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "NodeService.DrainNode" in [Action::"operate"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "OperationService.CancelOperation" in [Action::"operate"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.CreatePool" in [Action::"store"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.SetPool" in [Action::"store"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  // Where new buckets go (D232).
  action "S3Service.SetS3Placement" in [Action::"store"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "S3Service.DeleteS3Placement" in [Action::"store"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "S3Service.DeleteS3Bucket" in [Action::"store"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  // Realms (D248, D249): which pools a realm's tenants may use.
  action "RealmService.CreateRealm" in [Action::"store"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "RealmService.SetPoolRealms" in [Action::"store"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "RealmService.DeleteRealm" in [Action::"store", Action::"step-up"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.SetScrubSettings" in [Action::"store"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.StartScrub" in [Action::"store"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  // Weakening scrub is a deliberate choice (D226): a fresh login.
  action "ClusterService.WeakenScrubSettings" in [Action::"store", Action::"step-up"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.SetPoolDevice" in [Action::"store"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.DeletePool" in [Action::"store", Action::"step-up"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.CreateVolume" in [Action::"store"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.DeleteVolume" in [Action::"store", Action::"step-up"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.ListSnapshots" in [Action::"read"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.CreateSnapshot" in [Action::"operate"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.DeleteSnapshot" in [Action::"store", Action::"step-up"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.ExpandVolume" in [Action::"store"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.CloneVolume" in [Action::"store"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.RollbackVolume" in [Action::"store", Action::"step-up"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.FlattenVolume" in [Action::"store"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.CopyVolume" in [Action::"store"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.MoveVolume" in [Action::"store"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.CreateGroupSnapshot" in [Action::"operate"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "ClusterService.DeleteGroupSnapshot" in [Action::"store", Action::"step-up"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "TrashService.ListTrash" in [Action::"read"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "TrashService.GetTrashSettings" in [Action::"read"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "TrashService.RestoreFromTrash" in [Action::"operate"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "TrashService.PurgeFromTrash" in [Action::"store", Action::"step-up"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "TrashService.SetTrashSettings" in [Action::"store", Action::"step-up"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "AuditService.ListAudit" in [Action::"secure"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "AuditService.GetAuditSettings" in [Action::"secure"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "AuditService.SetAuditSettings" in [Action::"secure", Action::"step-up"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "MemberService.AddMember" in [Action::"store"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "MemberService.RemoveMember" in [Action::"store", Action::"step-up"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "TokenService.CreateToken" in [Action::"secure", Action::"step-up"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "TokenService.ListTokens" in [Action::"secure"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "TokenService.RevokeToken" in [Action::"secure"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  // S3's access keys are credentials, as tokens are (D231).
  action "S3Service.CreateS3Key" in [Action::"secure", Action::"step-up"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "S3Service.ListS3Keys" in [Action::"secure"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "S3Service.RevokeS3Key" in [Action::"secure"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  // Which gateway takes a tenant's keys (D250).
  action "RealmService.SetTenantRealm" in [Action::"secure", Action::"step-up"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  // Which volumes a host may attach (D251).
  action "RealmService.SetHostRealms" in [Action::"secure", Action::"step-up"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "CaService.ListCertificates" in [Action::"secure"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "CaService.RevokeCertificate" in [Action::"secure", Action::"step-up"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "MapService.GetMapBackup" in [Action::"secure", Action::"step-up"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "People.ListUsers" in [Action::"secure"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "People.SetRoles" in [Action::"secure", Action::"step-up"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "People.DeleteUser" in [Action::"secure", Action::"step-up"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "People.CreateToken" in [Action::"own", Action::"step-up"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "People.ListTokens" in [Action::"own"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
  action "People.RevokeToken" in [Action::"own"] appliesTo {
    principal: [User], resource: [Cluster], context: { "auth": Auth }
  };
}
